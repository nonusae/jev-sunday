  "cards": [
    {
      "dot": "cyan",
      "title": "The state object",
      "items": [
        "image_description: the prompt",
        "width, height: grid size",
        "coordinates: (0,0) top-left, x right, y down",
        "task: one coherent pixel-art image, no text"
      ]
    },
    {
      "dot": "violet",
      "title": "One question per judgment",
      "items": [
        "choice: 'What colour is pixel (x=3, y=5)?' + 16 colour names",
        "noul: 'Is pixel (x=3, y=5) inside the silhouette?'",
        "score: 'How light is pixel (x=3, y=5)?' + 5 levels",
        "IDs like x3_y5 are hidden from Jev; coords live in the text"
      ]
    },
    {
      "dot": "emerald",
      "title": "What comes back",
      "items": [
        "Answers keyed by the same IDs",
        "choice → probabilities + confidence; noul → P(yes); score → per-level probabilities",
        "pack() keeps every probability, not just the top answer"
      ]
    }
